#!/bin/sh
# Fake docker for tests: records the arguments and replies with the first rule
# (shell glob on the arguments) registered via `require("helpers").respond`.
printf '%s\n' "$*" >> "$DOCKER_TEST_DIR/calls"

if [ -f "$DOCKER_TEST_DIR/rules" ]; then
  while IFS='	' read -r pattern script; do
    # shellcheck disable=SC2254
    case "$*" in
      $pattern) exec sh "$script" ;;
    esac
  done < "$DOCKER_TEST_DIR/rules"
fi

echo "fake docker: no rule for: $*" >&2
exit 1
